      {
        "name": "add_topic_update",
        "title": "Agregar actualización a un tema",
        "description": "Operación transaccional: registra la actualización y opcionalmente cambia estado, pelota, próximo paso, decisión, compromiso y fuente.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "topicId": {
              "type": "string",
              "format": "uuid"
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "updateType": {
              "type": "string",
              "enum": [
                "note",
                "fact",
                "decision",
                "status_change",
                "milestone"
              ]
            },
            "isRelevant": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "waiting_client",
                "pending_us",
                "blocked",
                "monitoring",
                "resolved",
                "archived"
              ]
            },
            "ballWith": {
              "type": "string",
              "enum": [
                "us",
                "client",
                "third_party",
                "nobody"
              ]
            },
            "currentState": {
              "type": "string",
              "maxLength": 2000
            },
            "decision": {
              "type": "string",
              "maxLength": 1000
            },
            "commitment": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "responsibleParty": {
                  "type": "string",
                  "enum": [
                    "us",
                    "client",
                    "third_party"
                  ]
                },
                "responsibleName": {
                  "type": "string",
                  "maxLength": 160
                },
                "dueAt": {
                  "type": "string",
                  "format": "date-time"
                }
